# Server configuration
PORT=3000

# Private dashboard password
# Sign in at /owner with username: owner and your chosen password:
OWNER_PASSWORD=admin

# Keep 0 for local/direct access. Set to 1 if using a reverse proxy or ngrok tunnel.
TRUST_PROXY=0

# Set to 1 to record approximate country/city via ipwho.is (optional)
GEO_LOOKUP=0
