# Server configuration
PORT=3000

# Private dashboard credentials
# Sign in at /owner with this username and password:
OWNER_USERNAME=admin
OWNER_PASSWORD=admin

# Automatically detect visitor IP behind reverse proxies, Render, localtunnel, ngrok, Cloudflare
TRUST_PROXY=1

# Enable approximate country and city lookup for visitor IPs (1 = enabled, 0 = disabled)
GEO_LOOKUP=1
